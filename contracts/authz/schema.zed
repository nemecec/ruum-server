// Ruum SpiceDB schema, step 1 (docs/DESIGN.md, section 3; docs/decisions/0001), with the
// step 2 additions for database nodes (section 8.4 and 8.5; docs/STEP2.md) and the step 3
// additions for web apps (sections 9.2 to 9.10; DRAFT, docs/STEP3.md).
//
// Roles follow Google Drive: view < comment < edit < manage. A higher role includes all lower
// ones. Roles are inherited from parent folders; in step 1 a grant on a child can only add rights
// (decision 8). "Restricted" folders come later.
//
// `share` (change grants and share links) is a PERMISSION, not a role:
// - `manage` always has it;
// - `edit` has it while the effective node setting `editors_can_share` is true (the default);
//   a manager sets it per node, and children inherit it until a child sets its own value
//   (Drive: "Editors can change permissions and share");
// - in a team tenant, members get their content role from the team root (decision 0003-1:
//   `manage` by default, or `edit`, `comment`, `view`); members with `manage` get `share` from
//   it only while the tenant policy `members_can_share` is true, members with `edit` only while
//   `members_can_share` is true and the effective `editors_can_share` is true;
// - share links never have it.
//
// The right of an agent or an app that acts for a user is the user's right intersected with the
// agent's scope (subtree, highest role, expiry). The core service applies that intersection
// after the check (crates/ruum-core/src/authz); this schema does not model it.
//
// Object IDs are the UUIDs of the platform tables. Every relationship that the core writes is
// also implied by a row in Postgres (nodes.parent_id, nodes.editors_can_share, grants,
// share_links, memberships, tenants.settings), so the graph can be rebuilt from the database.
//
// The rebuild mapping of a `memberships` row of tenant T and user U (decision 0003-1; the
// invariant "content_role is not null if and only if role = member" is a CHECK constraint):
//
//   role = owner                          tenant:T#owner@user:U    tenant:T#member@user:U
//   role = admin                          tenant:T#admin@user:U    tenant:T#member@user:U
//   role = member, content_role = manage  tenant:T#member@user:U
//   role = member, content_role = edit    tenant:T#member@user:U   tenant:T#content_editor@user:U
//   role = member, content_role = comment tenant:T#member@user:U   tenant:T#content_commenter@user:U
//   role = member, content_role = view    tenant:T#member@user:U   tenant:T#content_viewer@user:U
//   role = guest                          tenant:T#guest@user:U
//
// Owners, admins and guests never hold a content_* tuple.

// A person.
definition user {}

// A set of users or groups. Managed in the platform or synced by SCIM (after step 1).
definition group {
    relation member: user | group#member
}

// An organisation that pays, or a private person.
// Every owner and admin also has the `member` relation, so `tenant#member` means
// "everybody in the organisation". Guests are not members; they only have grants.
definition tenant {
    relation owner: user
    relation admin: user
    relation member: user | group#member
    relation guest: user

    // `user:*` while the tenant policy `members_can_share` is true (the default for team
    // tenants). The core writes or deletes this one tuple when the policy changes.
    relation members_can_share: user:*

    // The content role of a member (decision 0003-1): what the member may do in the team tree.
    // At most one of these per member, written only for `role = member`. A member without one
    // manages the team tree (the default `content_role = manage`).
    relation content_viewer: user
    relation content_commenter: user
    relation content_editor: user

    // Change tenant settings, members, invitations; read the audit log.
    permission administer = owner + admin

    // The members who manage the team tree through the team root: every member without a
    // lower content role. Owners and admins hold `member` and never hold a content_* tuple.
    permission team_manager = member - (content_viewer + content_commenter + content_editor)

    // The members who edit, comment on or view the team tree through the team root. A higher
    // content role includes the lower ones. A "Can view" member still sees the whole team tree.
    permission team_editor = team_manager + (member & content_editor)
    permission team_commenter = team_editor + (member & content_commenter)
    permission team_viewer = team_commenter + (member & content_viewer)

    // The members who get `share` from the team root while the policy is on: managers always,
    // edit members as editors (the node setting `editors_can_share` applies, see
    // `node#sharing_editor`). View and comment members never share from the team root.
    permission sharing_member = team_manager & members_can_share
    permission sharing_team_editor = (member & content_editor) & members_can_share
}

// A deployed web app with its own identity (step 3, design 9.4). The ID of the live principal is
// the app node ID; a preview deployment is a principal of its own, with the deployment ID, so a
// preview's bindings (database branches, `view` on other nodes) never become the live app's.
// Bindings give an app a role on a node through `node#viewer` or `node#editor` (never manage);
// the deployer must hold that role (the core checks it; decision 0006-3).
definition app {
    relation tenant: tenant
    // The app node this principal belongs to.
    relation app_node: node
}

// Visitors without sign-in (step 3, design 9.9 audience `public`). Only `node#viewer` names it
// (`anonymous:*`), on the items of a public project; the API checks anonymous subjects only in
// the public read paths of those items. A public APP needs no tuple: the gateway lets everybody
// in when the app's setting `access` is `public`.
definition anonymous {}

// An AI agent principal. It always acts for one user (no team agents in step 1, decision 13).
definition agent {
    relation tenant: tenant
    relation acts_for: user
}

// A secret share link ("anyone with the link"). Opening the link gives the bearer a token for
// this principal; the link has the role that its grant on the node gives.
definition share_link {
    relation tenant: tenant
}

// A node of the tree: folder, file, link or typed node.
definition node {
    relation tenant: tenant

    // The parent folder. Rights flow down from it.
    relation parent: node

    // Folders that hold a `member` link to this node (design section 2.3). People who can view
    // such a folder can view this node; a member link never gives more than `view`.
    // Rules the core keeps (they are not in the graph):
    // - The link and its target are in the same tenant (a database trigger checks it).
    // - Making a member link needs `share` on the target. After that the link acts like a grant
    //   of `view` made by its creator: it stays when the creator loses `share`, and the tuple is
    //   deleted when the link is trashed or purged, or the target is purged.
    relation collection: node

    // The owner of a personal node tree has every right on it. Written ONLY on the root of a
    // personal tenant. `nodes.owner_id` (the creator) never becomes an `owner` tuple, so a
    // creator who leaves a team keeps no rights on what they made.
    relation owner: user

    // The team of a team tenant. Written ONLY on the root of a team tenant. Every member gets
    // its content role on the team tree (`manage` by default; decision 0003-1); `share` only
    // while the policy `members_can_share` is true.
    relation team: tenant

    // Grants to people (and apps). One relation per role.
    relation manager: user | group#member | tenant#member | tenant#administer
    relation editor: user | group#member | app | tenant#member
    relation commenter: user | group#member | tenant#member
    // `user:*` is for public files and apps; not used in step 1 (decision 9). Step 3: `user:*`
    // is "anyone signed in to Ruum" and `anonymous:*` is "anyone" for the items of a public
    // project (design 9.9; written only by updateProjectPublication, never on a folder).
    relation viewer: user | group#member | app | tenant#member | user:* | anonymous:*

    // Share links, one relation per link role. Kept apart from the grants to people so that a
    // link never gets `share` (and never `manage`: there is no relation for it).
    relation link_editor: share_link
    relation link_commenter: share_link
    relation link_viewer: share_link

    // The node setting `editors_can_share` (nodes.editors_can_share). The core writes `user:*`
    // on `editors_share_off` when a manager sets it to false, on `editors_share_on` when a
    // manager sets it to true, and neither when the node inherits (null).
    relation editors_share_off: user:*
    relation editors_share_on: user:*

    // True (for every user) where the effective `editors_can_share` is false: the node sets
    // false, or it inherits false from the nearest ancestor that sets a value.
    permission editors_cannot_share = editors_share_off + (parent->editors_cannot_share - editors_share_on)

    // Move, trash, restore; change node settings such as `editors_can_share`.
    permission manage = owner + manager + team->team_manager + parent->manage

    // Change content, upload versions, rename, create children.
    permission edit = manage + editor + link_editor + team->team_editor + parent->edit

    // Comment (comments come after step 1; the role exists now).
    permission comment = edit + commenter + link_commenter + team->team_commenter + parent->comment

    // Read, download, list.
    permission view = comment + viewer + link_viewer + team->team_viewer + parent->view + collection->view

    // The `manage` that always shares: ownership, manager grants, and team members with
    // `manage` while the policy `members_can_share` is true.
    permission sharing_manager = owner + manager + team->sharing_member + parent->sharing_manager

    // The `edit` grants to people (never share links), and edit members of the team while the
    // policy `members_can_share` is true, inherited down the tree.
    permission sharing_editor = editor + team->sharing_team_editor + parent->sharing_editor

    // Change grants and share links (a permission, not a role).
    permission share = sharing_manager + (sharing_editor - editors_cannot_share)

    // ---------------------------------------------------------------- step 2: databases (DRAFT)
    // Database nodes are ordinary nodes (kind `typed`, type `database`), so the roles above
    // apply; these permissions name what each role means for a database (design section 3.2):
    //   view   = read-only queries (`query_read`)
    //   edit   = read-write queries (`query_write`)
    //   manage = schema, settings, backups, restore, branches (`change_schema`)
    // The core checks them with the subject of the request (the user, also for an agent), and
    // intersects the answer with the agent's scope, as for every node.
    permission query_read = view
    permission query_write = edit
    permission change_schema = manage

    // Real `secret` values (design 8.5; decision 0004). People with `manage` only. The core
    // never asks this for an agent: an agent never sees a secret, whatever its user's role.
    permission read_secret = manage

    // How the names map (DatabasePermissions in openapi.yaml, checkAccess in
    // contracts/providers/provider.openapi.yaml): query_read, query_write, change_schema and
    // read_secret are the permissions above; `write_live` is agent_write_live and
    // `read_personal` is agent_read_personal below.

    // The agent rules of section 8.5. The subject of these checks is the AGENT principal (not
    // its user). The core allows an agent's write on a live database only when BOTH hold:
    // `query_write` for its user (after the scope) and `agent_write_live` for the agent. The
    // same for real personal values: `query_read` for the user and `agent_read_personal` for
    // the agent. `secret` values are never shown to agents: there is no relation for it.

    // Written ONLY on a database branch node (`databases.branch_of` is set) whose data is
    // `masked` or `schema_only`: every agent may write there, within its user's `edit` and its
    // scope (drafts write freely, section 8.5). A branch with `full` data has real values, so
    // it gets no `draft_branch`: an agent needs a `live_writer` grant there, as on a live
    // database.
    relation draft_branch: agent:*

    // A time-limited grant (createDatabaseAccessGrant, table `database_access_grants`). The
    // expiry is NOT in the graph: like the agent scope, the core checks
    // `database_access_grants.expires_at` and `revoked_at` after the check, and the sweeper
    // deletes the tuple when the grant ends or is revoked. (SpiceDB relationship expiration,
    // `use expiration`, would move the expiry into the graph; the in-memory engine of
    // crates/ruum-core/src/authz/schema.rs does not read it yet. Open question in docs/STEP2.md.)
    relation live_writer: agent
    relation personal_reader: agent

    // An agent may write: on a branch always, on a live database only with a grant.
    // Not inherited: a grant on one database never reaches its branches' parent or siblings,
    // and a branch is a database of its own.
    permission agent_write_live = draft_branch + live_writer

    // An agent may see real `personal` values (otherwise pseudonyms).
    permission agent_read_personal = personal_reader

    // ---------------------------------------------------------------- step 3: web apps (DRAFT)
    // Web app nodes are ordinary nodes (kind `typed`, type `webapp`); what each role means for an
    // app (design section 3.2):
    //   view   = use the app (plus app-defined roles, `use` below)
    //   edit   = deploy previews, publish (agents: the publish waits for a person), read logs,
    //            metrics, traces and error events (logs can hold personal data, design 9.6)
    //   manage = settings, secrets, domains, partner API keys, telemetry classes
    //   share  = grants on the node and every app role
    // The core checks them with the subject of the request (the user, also for an agent) and
    // intersects the answer with the agent's scope, as for every node.

    // One tuple per ACTIVE role of the live manifest: node:<app>#active_role@app_role:<app>/<r>#has.
    // A grant of any active app role lets its holder use the app (design 9.3).
    relation active_role: app_role#has

    // The gateway's check before a request reaches the app (design 9.2).
    permission use = view + active_role
    // Opening a preview (decision 0006, review RC-7). The gateway checks this permission, never
    // `edit` directly, so step 5 (commenters annotate a shared preview) widens one line here.
    permission open_preview = edit
    permission deploy = edit
    permission publish = edit
    permission read_telemetry = edit
    permission configure = manage
}

// Roles that a web app declares in its manifest (design section 9.3). ID: "<app-node-id>/<role>".
// Step 3 (DRAFT). The role names come from the live manifest. `active` holds `user:*` while the
// live manifest declares the role; a new version that removes the role deletes that one tuple,
// so the grants (`holder`) stay but give nothing, and a rollback writes it again (design 9.3).
// `granter` points from every role to the role that the manifest marks `grants_roles`.
// The default role (`default: true`) is not in the graph: the gateway gives it to a visitor with
// `view` on the app node and no explicit active role.
definition app_role {
    relation app: node
    relation holder: user | group#member | tenant#member
    relation granter: app_role
    relation active: user:*

    permission has = holder & active
    permission grant = app->share + granter->has
}

// A scope of an API that a web app offers to other apps (design 9.10). ID:
// "<app-node-id>/<api>/<scope>", with each `.` of the scope written as `|` (SpiceDB object IDs
// have no `.`): `orders.read` is `.../orders/orders|read`. A binding of a calling app writes `consumer@app:<caller>`; the
// deployer of the calling app must have `grant` (manage on the called app, or a holder of the
// app role that the API's `granted_by` names). The core records `granted_by`.
definition app_api_scope {
    relation app: node
    relation consumer: app
    relation granter: app_role

    permission call = consumer
    permission grant = app->configure + granter->has
}

// Tuples that the core writes when a tenant is made:
//
//   personal tenant T of user U, root folder R:
//     tenant:T#owner@user:U   tenant:T#member@user:U
//     node:R#tenant@tenant:T  node:R#owner@user:U
//
//   team tenant T made by user U, root folder R:
//     tenant:T#owner@user:U   tenant:T#member@user:U
//     node:R#tenant@tenant:T
//     node:R#manager@tenant:T#administer  (owners and admins manage, and so share, everything
//                                          in the team tree)
//     node:R#team@tenant:T                (every member has its content role on the team
//                                          tree; `manage` by default: edit, move, trash and
//                                          restore, also what others made)
//     tenant:T#members_can_share@user:*   (only while the policy `members_can_share` is true;
//                                          the core writes or deletes it when the policy changes)
//
// No tuple names the creator of a node. Members who leave lose `tenant#member` and with it
// every right that came from the team root.
//
// Tuples per node: node:N#parent@node:P and node:N#tenant@tenant:T.
// A member link L in folder F to target X: node:X#collection@node:F.
// A grant of role r to principal p on node N: node:N#<relation of r>@<p>, where the relation of
//   view, comment, edit, manage is viewer, commenter, editor, manager.
// A share link S with role r on node N: node:N#link_<viewer|commenter|editor>@share_link:S.
// The setting editors_can_share of node N: false -> node:N#editors_share_off@user:*,
//   true -> node:N#editors_share_on@user:*, null (inherit) -> neither.
//
// Step 2 (DRAFT), database nodes:
//   a branch B of database D (B is a child node of D):  node:B#parent@node:D
//   ... and only when B holds masked or schema_only data: node:B#draft_branch@agent:*
//   a write_live grant to agent A on D:                node:D#live_writer@agent:A
//   a read_personal grant to agent A on D:             node:D#personal_reader@agent:A
//   The grant's end (expiry or revoke) deletes its tuple; the core also checks the row in
//   `database_access_grants`, so a tuple that the sweeper has not deleted yet gives nothing.
//
// Step 3 (DRAFT), web app nodes:
//   the live principal of app node A:            app:A#tenant@tenant:T  app:A#app_node@node:A
//   a preview deployment P of A:                 app:P#tenant@tenant:T  app:P#app_node@node:A
//   a binding of A with role edit on node N:     node:N#editor@app:A   (view: node:N#viewer@app:A)
//   a preview's database binding to branch B:    node:B#editor@app:P
//   an active role r of A's live manifest:       app_role:A/r#app@node:A
//                                                app_role:A/r#active@user:*
//                                                node:A#active_role@app_role:A/r#has
//   the role g with grants_roles:                app_role:A/r#granter@app_role:A/g  (every r)
//   a grant of role r to user U:                 app_role:A/r#holder@user:U
//   an API scope s of API x of app B, bound by A: app_api_scope:B/x/s#app@node:B
//                                                app_api_scope:B/x/s#consumer@app:A
//   the item I of a public project, audience public:     node:I#viewer@anonymous:*
//   ...                                  audience signed_in:  node:I#viewer@user:*
//   A binding's end (a new live deployment drops it, the preview expires, the app is trashed)
//   deletes its tuple and writes `app.binding_revoked`. The rows of `app_bindings` and
//   `app_role_grants` imply every tuple above, so the graph can be rebuilt.
