{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruum.space/contracts/events/journal-entry.schema.json",
  "title": "Journal entry",
  "description": "One change in the tenant journal (docs/DESIGN.md, section 2.5). The changes feed (GET /v1/changes), agent activity, the outbox to the event bus and webhooks all carry this envelope. `seq` grows by one per change in the tenant. `data` depends on `type`.",
  "type": "object",
  "required": [
    "tenant_id",
    "seq",
    "node_id",
    "revision",
    "type",
    "actor",
    "on_behalf_of",
    "at",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "tenant_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "node_id": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ],
      "description": "The revision of the node after the change (`nodes.revision`), so clients can order and dedupe per node. Null when the entry has no node or the node is purged."
    },
    "type": {
      "enum": [
        "node.created",
        "node.renamed",
        "node.moved",
        "node.copied",
        "node.trashed",
        "node.restored",
        "node.purged",
        "version.created",
        "version.restored",
        "version.labeled",
        "tag.attached",
        "tag.detached",
        "grant.added",
        "grant.updated",
        "grant.removed",
        "share_link.created",
        "share_link.revoked",
        "node.sharing_updated",
        "typed_node.status_changed",
        "database.columns_confirmed",
        "database.migration_applied",
        "database.migration_failed",
        "database.branch_created",
        "database.restore_started",
        "database.restored",
        "database.restore_failed",
        "database.grant_created",
        "database.grant_revoked",
        "database.approval_decided",
        "app.deployed",
        "app.deployment_failed",
        "app.rolled_back",
        "app.settings_changed",
        "app.binding_granted",
        "app.binding_revoked",
        "app.role_granted",
        "app.role_revoked",
        "app.secret_changed",
        "app.domain_added",
        "app.domain_removed",
        "app.api_key_created",
        "app.api_key_revoked",
        "app.approval_decided",
        "app.telemetry_fields_confirmed",
        "issue.created",
        "issue.status_changed",
        "issue.reveal_requested",
        "issue.reveal_decided",
        "template.instantiated",
        "project.publication_changed"
      ],
      "description": "The event type. The types in `$defs/planned_types` (step 2 and step 3) are specified but not written by the server yet (decision 0004-21); the task that builds the first writer of a type removes it from that list."
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/principal_ref",
      "description": "The user, agent or app that did the change."
    },
    "on_behalf_of": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "The user for whom the actor acted; null when the actor is the user."
    },
    "on_behalf_of_display_name": {
      "type": "string",
      "description": "The current name of the `on_behalf_of` user. Filled by the API when known (for example in GET /v1/changes). Never stored in the journal."
    },
    "at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "data": {
      "type": "object",
      "description": "The data of the change; its shape depends on `type`. IDs in `data` may name nodes that the reader cannot see, also nodes that are gone (for example `old_parent_id` of a move); resolve them with getNode, which answers 404. Names, paths and every other attribute of such a node never appear (decision 0003-8)."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "node.created"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "node.created.schema.json"
          }
        }
      }
    },
    {
      "if": {
