{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruum.space/contracts/events/database.grant_created.schema.json",
  "title": "database.grant_created",
  "description": "A time-limited grant was given to an agent (`createDatabaseAccessGrant`, or an approved grant request). `node_id` of the entry is the database. Names, IDs and counts only: never a row value, a parameter or an engine message (decision 0004-8). This schema is the `data` of a journal entry with `type` `database.grant_created`. Step 2, planned (decision 0004-21).",
  "type": "object",
  "required": [
    "grant_id",
    "kind",
    "agent_id",
    "expires_at",
    "restore_point_id",
    "approval_id"
  ],
  "additionalProperties": false,
  "properties": {
    "grant_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "kind": {
      "enum": [
        "write_live",
        "read_personal"
      ]
    },
    "agent_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "expires_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "restore_point_id": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "approval_id": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
