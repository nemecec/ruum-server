{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruum.space/contracts/events/database.columns_confirmed.schema.json",
  "title": "database.columns_confirmed",
  "description": "A person confirmed the classes of columns (`confirmColumnClasses`, or `decideDatabaseApproval` with `classes`). `node_id` of the entry is the database. Names, IDs and counts only: never a row value, a parameter or an engine message (decision 0004-8). This schema is the `data` of a journal entry with `type` `database.columns_confirmed`. Step 2, planned (decision 0004-21).",
  "type": "object",
  "required": [
    "version_id",
    "approval_id",
    "columns"
  ],
  "additionalProperties": false,
  "properties": {
    "version_id": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "The new manifest version with the confirmed `data_classes`."
    },
    "approval_id": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": [
          "schema",
          "table",
          "column",
          "class",
          "old_class"
        ],
        "additionalProperties": false,
        "properties": {
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "table": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "column": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "class": {
            "enum": [
              "normal",
              "personal",
              "secret"
            ]
          },
          "old_class": {
            "oneOf": [
              {
                "enum": [
                  "normal",
                  "personal",
                  "secret"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
