{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruum.space/contracts/events/app.deployed.schema.json",
  "title": "app.deployed",
  "description": "A deployment of a web app is ready (a preview) or live (a publish or a rollback). `node_id` of the entry is the app node. A live deployment also writes `version.created` (encoding `app_release_v1`). This schema is the `data` of a journal entry with `type` `app.deployed`. Step 3, planned (decision 0004-21, docs/STEP3.md).",
  "type": "object",
  "required": [
    "deployment_id",
    "environment",
    "version_id",
    "previous_deployment_id",
    "kind",
    "migrations_applied",
    "approval_id"
  ],
  "additionalProperties": false,
  "properties": {
    "deployment_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "environment": {
      "enum": [
        "live",
        "preview"
      ]
    },
    "version_id": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "previous_deployment_id": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "enum": [
        "preview",
        "publish",
        "rollback"
      ]
    },
    "migrations_applied": {
      "type": "integer",
      "minimum": 0
    },
    "approval_id": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
