    },
    "picker-max": {
      "$value": {
        "value": 256,
        "unit": "px"
      }
    },
    "field-sm": {
      "$value": {
        "value": 256,
        "unit": "px"
      },
      "$description": "Short fields (a space switcher, a date)"
    },
    "field-md": {
      "$value": {
        "value": 448,
        "unit": "px"
      },
      "$description": "Search field"
    },
    "toast": {
      "$value": {
        "value": 512,
        "unit": "px"
      }
    },
    "progress": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "meter": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "dot": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    }
  },
  "duration": {
    "$type": "duration",
    "instant": {
      "$value": {
        "value": 0,
        "unit": "ms"
      },
      "$description": "Reduced motion: no transition"
    },
    "fast": {
      "$value": {
        "value": 120,
        "unit": "ms"
      }
    },
    "base": {
      "$value": {
        "value": 200,
        "unit": "ms"
      }
    },
    "exit": {
      "$value": {
        "value": 150,
        "unit": "ms"
      }
    },
    "highlight": {
      "$value": {
        "value": 2000,
        "unit": "ms"
      }
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    },
    "exit": {
      "$value": [
        0.4,
        0,
        1,
        1
      ]
    }
  },
  "motion": {
    "$type": "transition",
    "fast": {
      "$value": {
        "duration": "{duration.fast}",
        "delay": {
          "value": 0,
          "unit": "ms"
        },
        "timingFunction": "{easing.standard}"
      },
      "$description": "Hover, press, focus"
    },
    "base": {
      "$value": {
        "duration": "{duration.base}",
        "delay": {
          "value": 0,
          "unit": "ms"
        },
        "timingFunction": "{easing.standard}"
      },
      "$description": "Panels, dialogs, toasts in"
    },
    "exit": {
      "$value": {
        "duration": "{duration.exit}",
        "delay": {
          "value": 0,
          "unit": "ms"
        },
        "timingFunction": "{easing.exit}"
      },
      "$description": "Things that leave"
    }
  },
  "opacity": {
    "$type": "number",
    "disabled": {
      "$value": 0.5
    }
  },
  "z": {
    "$type": "number",
    "raised": {
      "$value": 1
    },
    "sticky": {
      "$value": 5
    },
    "sheet": {
      "$value": 15
    },
    "upload": {
      "$value": 20
    },
    "toast": {
      "$value": 30
    },
    "banner": {
      "$value": 40
    },
    "skip": {
      "$value": 50
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "$description": "CSS cannot read custom properties in media queries: the CSS repeats these values (stylelint allows px only there).",
    "narrow": {
      "$value": {
        "value": 640,
        "unit": "px"
      }
    },
    "wide": {
      "$value": {
        "value": 900,
        "unit": "px"
      }
    }
  }
}
