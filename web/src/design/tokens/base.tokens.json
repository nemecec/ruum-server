        "value": 44,
        "unit": "px"
      },
      "$description": "Touch target"
    },
    "icon": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "icon-sm": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "icon-lg": {
      "$value": {
        "value": 48,
        "unit": "px"
      },
      "$description": "Empty state illustration"
    },
    "check": {
      "$value": {
        "value": 18,
        "unit": "px"
      },
      "$description": "Checkbox and radio"
    },
    "topbar": {
      "$value": {
        "value": 56,
        "unit": "px"
      }
    },
    "rail": {
      "$value": {
        "value": 224,
        "unit": "px"
      }
    },
    "content": {
      "$value": {
        "value": 1200,
        "unit": "px"
      },
      "$description": "Content max width"
    },
    "panel": {
      "$value": {
        "value": 360,
        "unit": "px"
      },
      "$description": "Details panel and upload panel"
    },
    "dialog-sm": {
      "$value": {
        "value": 480,
        "unit": "px"
      }
    },
    "dialog-md": {
      "$value": {
        "value": 720,
        "unit": "px"
      }
    },
    "dialog-lg": {
      "$value": {
        "value": 1024,
        "unit": "px"
      }
    },
    "dialog-full-height": {
      "$value": {
        "value": 768,
        "unit": "px"
      }
    },
    "measure": {
      "$value": {
        "value": 40,
        "unit": "rem"
      },
      "$description": "Line length of running text (about 72 characters)"
    },
    "narrow": {
      "$value": {
        "value": 30,
        "unit": "rem"
      },
      "$description": "Sign-in and other single-column pages"
    },
    "empty-max": {
      "$value": {
        "value": 420,
        "unit": "px"
      }
