{
  "name": "ruum-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode mock",
    "dev:server": "vite",
    "gen:api": "openapi-typescript ../contracts/openapi.yaml -o src/api/schema.d.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint && stylelint \"src/**/*.css\" && node scripts/check-ui-rules.mjs && node scripts/build-tokens.mjs --check",
    "tokens": "node scripts/build-tokens.mjs",
    "ladle": "ladle serve",
    "ladle:build": "ladle build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@ladle/react": "5.1.1",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.17.1",
    "axe-core": "4.14.0",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.90.0",
    "style-dictionary": "5.7.1",
    "stylelint": "17.16.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "typescript": "~5.9",
    "vite": "^8.3.6",
    "vitest": "^4.1.12",
    "yaml": "^2.8.1"
  },
  "license": "Apache-2.0"
}
