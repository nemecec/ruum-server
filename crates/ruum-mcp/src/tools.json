  {
   "name": "add_grant",
   "operation": "addGrant",
   "description": "Give a person access to a file or folder with a role (view, comment, edit or manage). Needs the share permission; you can give at most your own role.",
   "notes": null,
   "method": "POST",
   "path": "/v1/nodes/{node_id}/grants",
   "params": [
    {
     "name": "node_id",
     "in": "path",
     "prop": "node_id"
    }
   ],
   "body": "json",
   "input_schema": {
    "type": "object",
    "properties": {
     "node_id": {
      "type": "string",
      "format": "uuid",
      "description": "A UUIDv7."
     },
     "body": {
      "type": "object",
      "required": [
       "grantee",
       "role"
      ],
      "properties": {
       "grantee": {
        "description": "Who gets the role.",
        "oneOf": [
         {
          "type": "object",
          "description": "A user by ID (a member or a guest).",
          "required": [
           "type",
           "id"
          ],
          "properties": {
           "type": {
            "type": "string",
            "const": "user"
           },
           "id": {
            "type": "string",
            "format": "uuid",
            "description": "A UUIDv7."
           },
           "display_name": {
            "type": "string",
            "description": "The name of the user, filled in responses (as `PrincipalRef.display_name`)."
           },
           "email": {
            "type": "string",
            "description": "Filled in responses only for callers who may share the node and who may list the members of the tenant (a member, admin or owner, or an agent of one). Absent for guests, so the grant list tells a guest no email address (decision 0003-5)."
           }
          }
         },
         {
          "type": "object",
          "description": "A person by email. A person who is not a member becomes a guest only when the invitation is accepted or the verified email claims it (see `addGrant`).",
          "required": [
           "type",
           "email"
          ],
          "properties": {
           "type": {
            "type": "string",
            "const": "email"
           },
           "email": {
            "type": "string",
            "format": "email"
           }
          }
         },
         {
          "type": "object",
          "description": "Everybody in the tenant of the node (`tenant#member`).",
          "required": [
           "type"
          ],
          "properties": {
           "type": {
            "type": "string",
            "const": "tenant_members"
           }
          }
         }
        ],
        "discriminator": {
         "propertyName": "type",
         "mapping": {
          "user": "#/components/schemas/GranteeUser",
          "email": "#/components/schemas/GranteeEmail",
          "tenant_members": "#/components/schemas/GranteeTenantMembers"
         }
        }
       },
       "role": {
        "type": "string",
        "description": "The roles of design section 3.2 (the Google Drive model), from lowest to highest. A higher\nrole includes the lower ones. `share` is a permission, not a role: `manage` always has it,\n`edit` has it while the node's effective `editors_can_share` is true.\n",
        "enum": [
         "view",
         "comment",
         "edit",
         "manage"
        ]
       },
       "notify": {
        "type": "boolean",
        "default": true,
        "description": "Send an email to the grantee."
       },
       "message": {
        "type": "string",
        "maxLength": 1000
       }
      }
     }
    },
    "additionalProperties": false,
    "required": [
     "node_id",
     "body"
    ]
   }
  },
