  {
   "name": "update_node_sharing",
   "operation": "updateNodeSharing",
   "description": "Set whether editors may share a file or folder (editors_can_share: true, false, or null to inherit). Needs manage.",
   "notes": null,
   "method": "PATCH",
   "path": "/v1/nodes/{node_id}/sharing",
   "params": [
    {
     "name": "node_id",
     "in": "path",
     "prop": "node_id"
    },
    {
     "name": "If-Match",
     "in": "header",
     "prop": "if_match"
    }
   ],
   "body": "json",
   "input_schema": {
    "type": "object",
    "properties": {
     "node_id": {
      "type": "string",
      "format": "uuid",
      "description": "A UUIDv7."
     },
     "if_match": {
      "type": "string",
      "description": "The node ETag (`\"<revision>\"`). The write fails with `412 precondition_failed` if the node changed."
