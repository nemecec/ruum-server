# A hostile variant of the fixture (card R-2a review, change 1): the image declares a volume on a
# folder anyone can write. Docker would give it an anonymous, writable volume with no size limit,
# also under a read-only root, so the driver must refuse the image.
FROM node:22-alpine@sha256:1314fb30ec37592d5845e5a160d522c0e680972aa534549940b8d73bde88481a
RUN mkdir -p /data && chmod 1777 /data
COPY main.js /app/main.js
ENTRYPOINT ["node", "/app/main.js"]
VOLUME /data
