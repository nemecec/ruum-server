# Laptop stack settings. `scripts/dev.sh up` copies this file to .env on the first run
# and replaces each @random-...@ marker with a new random value. Never commit .env.

# Postgres (host port 5434). The superuser is for admin work; the Ruum server uses the ruum role.
POSTGRES_PASSWORD=@random-hex32@
RUUM_DB_PASSWORD=@random-hex32@
ZITADEL_DB_PASSWORD=@random-hex32@
SPICEDB_DB_PASSWORD=@random-hex32@

# The data cluster postgres-data (host port 5435): customer databases only. The superuser logs in
# only with docker exec; the Ruum server uses ruum_dbhost (RUUM_DBHOST_URL of `dev.sh env`).
POSTGRES_DATA_PASSWORD=@random-hex32@
RUUM_DBHOST_PASSWORD=@random-hex32@
# Database bindings of apps (card B-1d), all optional:
# - the address that the RUUM_BINDING_<NAME> URLs name (default: the data cluster's own address;
#   the pooler of backlog D5-4 sets it later);
# RUUM_DATA_APP_HOST=127.0.0.1
# RUUM_DATA_APP_PORT=5435
# - the most connections that the app roles of one space may hold (default: a tenth of the app
#   budget, which is half of max_connections);
# RUUM_DATA_APP_TENANT_SHARE=10
# - the sslmode of the URLs (default prefer);
# RUUM_APP_DB_SSLMODE=prefer
# - how long the stage `bindings` waits for the masked branch of a preview (seconds, default 120).
# RUUM_APP_DB_BRANCH_WAIT_SECS=120

# Garage (S3). The key ID must be "GK" + 24 hex characters, the secret 64 hex characters.
GARAGE_RPC_SECRET=@random-hex64@
GARAGE_ADMIN_TOKEN=@random-hex32@
S3_BUCKET=ruum-dev
S3_ACCESS_KEY_ID=GK@random-hex24@
S3_SECRET_ACCESS_KEY=@random-hex64@

# Zitadel. The master key must be exactly 32 characters.
ZITADEL_MASTERKEY=@random-hex32@
ZITADEL_ADMIN_USERNAME=admin
ZITADEL_ADMIN_PASSWORD=Ruum-@random-hex24@!

# SpiceDB
SPICEDB_PRESHARED_KEY=@random-hex32@

# OpenBao (dev mode: in memory, unsealed, data is lost on restart)
BAO_DEV_ROOT_TOKEN=@random-hex32@

# Where Caddy sends https://ruum.localhost. The Ruum server runs on the host.
RUUM_UPSTREAM=host.docker.internal:8490

# Where Caddy sends https://dav.ruum.localhost, the WebDAV host (RUUM_DAV_BIND of the server).
RUUM_DAV_UPSTREAM=host.docker.internal:8492

# Where Caddy sends the web UI paths of https://ruum.localhost: Vite on the host
# (cd web && npm run dev:server). Change the port here when you set RUUM_WEB_PORT.
RUUM_WEB_UPSTREAM=host.docker.internal:5173

# The telemetry stack (profile apps: scripts/dev.sh up --apps; docs/DEVSTACK.md "Telemetry stack
# (profile apps)"). Host ports, all on 127.0.0.1. A value in the environment wins over this file.
RUUM_OTLP_GRPC_PORT=4317
RUUM_OTLP_HTTP_PORT=4318
RUUM_LOKI_PORT=3100
RUUM_MIMIR_PORT=9009
RUUM_TEMPO_PORT=3200
