# Laptop stack settings. `scripts/dev.sh up` copies this file to .env on the first run
# and replaces each @random-...@ marker with a new random value. Never commit .env.

# Postgres (host port 5434). The superuser is for admin work; the Ruum server uses the ruum role.
POSTGRES_PASSWORD=@random-hex32@
RUUM_DB_PASSWORD=@random-hex32@
ZITADEL_DB_PASSWORD=@random-hex32@
SPICEDB_DB_PASSWORD=@random-hex32@

# Garage (S3). The key ID must be "GK" + 24 hex characters, the secret 64 hex characters.
GARAGE_RPC_SECRET=@random-hex64@
GARAGE_ADMIN_TOKEN=@random-hex32@
S3_BUCKET=ruum-dev
S3_ACCESS_KEY_ID=GK@random-hex24@
S3_SECRET_ACCESS_KEY=@random-hex64@

# Zitadel. The master key must be exactly 32 characters.
ZITADEL_MASTERKEY=@random-hex32@
ZITADEL_ADMIN_USERNAME=admin
ZITADEL_ADMIN_PASSWORD=Ruum-@random-hex24@!

# SpiceDB
SPICEDB_PRESHARED_KEY=@random-hex32@

# OpenBao (dev mode: in memory, unsealed, data is lost on restart)
BAO_DEV_ROOT_TOKEN=@random-hex32@

# Where Caddy sends https://ruum.localhost. The Ruum server runs on the host.
RUUM_UPSTREAM=host.docker.internal:8490

# Where Caddy sends the web UI paths of https://ruum.localhost: Vite on the host
# (cd web && npm run dev:server). Change the port here when you set RUUM_WEB_PORT.
RUUM_WEB_UPSTREAM=host.docker.internal:5173
