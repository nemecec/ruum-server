# Every pinned version of staging. Shell syntax (sourced by the scripts), one NAME=value per line.
# Renovate reads the "# renovate:" comments (.github/renovate.json5) and opens pull requests.
# Upgrades: change a line in a pull request, then `deploy/staging/up.sh` (plan) and the panel.

# --- Tools of the staging steps (checked by SHA-256) ---
# setup.sh installs them into the tools image on the Mac (tools-image.sh, linux arm64) and into
# CI (linux amd64). The base of the tools image, pinned by digest:
# renovate-image: depName=alpine
TOOLS_BASE_IMAGE=alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
# renovate: datasource=github-releases depName=opentofu/opentofu
TOFU_VERSION=1.13.9
TOFU_SHA256_ARM64=5dc196dde75b667e4806d358310ec96742774cd0993c54c1237efee5644b69b8
TOFU_SHA256_AMD64=b34b327cc1ef07178207b6f2cd1f5276537d3e5b7be316500f6dac50d4c0a857
# renovate: datasource=github-releases depName=siderolabs/talos
TALOS_VERSION=v1.14.5
TALOSCTL_SHA256_ARM64=dfd3aa33c3159810e216fc39afb685d4d120c8f2728e017d8c7f7635d3139382
TALOSCTL_SHA256_AMD64=ff432b68986709e6b69c563a08a2ced4232d5196b0dccd6d2e783e9d714d7d7d
# Kubernetes of the cluster and the kubectl that matches it.
KUBERNETES_VERSION=v1.37.2
KUBECTL_SHA256_ARM64=fcc16f63186659d9722014b7e02d5fdd2d4e669cb8c0ab66365d7d3b8ba03509
KUBECTL_SHA256_AMD64=c04487523e7aa7d1493f7808174c899db93d7a9cf57531420cd76b9bd415f8f4
# renovate: datasource=github-releases depName=helm/helm
HELM_VERSION=v4.3.1
HELM_SHA256_ARM64=8cf8f66ecbc252ac8f7f06cca68aba88508ddfde3a6a34feb1678ad1694b4f88
HELM_SHA256_AMD64=0403a88ae20913d11b10a2467b50087721fea7581736da6b9d3992f5357fe54b
# renovate: datasource=github-releases depName=helmfile/helmfile
HELMFILE_VERSION=1.8.3
HELMFILE_SHA256_ARM64=e035c0338e31e0a8054ae798280532d32edcfbb7d6c4993e3b2efa2dc40647ce
HELMFILE_SHA256_AMD64=7d79c6d2099a4819213873164eda23bdbd32f1404fec7a7104d934e5d102596f
# renovate: datasource=github-releases depName=hetznercloud/cli
HCLOUD_CLI_VERSION=v1.70.2
HCLOUD_CLI_SHA256_ARM64=05820ba0e3141b212c7cff036d1bd7cd35843e96d7033c2036ffe76253ebbea8
HCLOUD_CLI_SHA256_AMD64=b844bd28240112b0254183ba5266d0a0f59a6167c196636936459755efb88050
# The provenance check of the images in the tools container (ops/deploy-chart.sh, code review F-3).
# renovate: datasource=github-releases depName=sigstore/cosign
COSIGN_VERSION=v3.1.4
COSIGN_SHA256_ARM64=ade83b7aac62e131cacfe96d958948b2150cc9efec46a570a2649b8e27dedad2
COSIGN_SHA256_AMD64=424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa
# renovate: datasource=github-releases depName=apricote/hcloud-upload-image
HCLOUD_UPLOAD_IMAGE_VERSION=1.5.0
HCLOUD_UPLOAD_IMAGE_SHA256_ARM64=cf6736a34b7c28d4f84982be7a07c9422caad3a419606cd38f18f47405ae598b
HCLOUD_UPLOAD_IMAGE_SHA256_AMD64=1b8b74e919a8192b23bdbd61fa145bbe49bd76f8595ec52d46f9f9b37a048596

# --- Talos image (Image Factory, platform hcloud, amd64, no extensions) ---
# The schematic of a vanilla image (no extensions, no extra kernel arguments).
TALOS_SCHEMATIC=376567988ad370138ad8b2698212367b8edcb69b5fd68c80be1f2ec7d603b4ba
TALOS_IMAGE_URL=https://factory.talos.dev/image/${TALOS_SCHEMATIC}/${TALOS_VERSION}/hcloud-amd64.raw.xz
TALOS_INSTALLER_IMAGE=factory.talos.dev/installer/${TALOS_SCHEMATIC}:${TALOS_VERSION}

# --- Platform charts (helmfile) ---
# renovate: datasource=helm registryUrl=https://cloudnative-pg.github.io/charts depName=cloudnative-pg
CNPG_CHART_VERSION=0.29.1
CNPG_OPERATOR_VERSION=1.30.1
# renovate: datasource=helm registryUrl=https://cloudnative-pg.github.io/charts depName=plugin-barman-cloud
BARMAN_PLUGIN_CHART_VERSION=0.9.0
BARMAN_PLUGIN_VERSION=v0.16.0
# renovate: datasource=helm registryUrl=https://charts.zitadel.com depName=zitadel
ZITADEL_CHART_VERSION=10.5.0
# One Zitadel pin for the laptop and staging (review 2 U-5). tests/run.sh checks that
# deploy/dev/docker-compose.yml uses the same tag.
ZITADEL_VERSION=v4.19.5
# renovate: datasource=helm registryUrl=https://nats-io.github.io/k8s/helm/charts depName=nats
NATS_CHART_VERSION=2.15.2
NATS_VERSION=2.15.2
# The same SpiceDB as deploy/dev (checked by tests/run.sh).
SPICEDB_VERSION=v1.56.2
# renovate: datasource=github-releases depName=rancher/local-path-provisioner
LOCAL_PATH_PROVISIONER_VERSION=v0.0.37
# renovate: datasource=github-releases depName=kubernetes-sigs/kube-network-policies
KUBE_NETWORK_POLICIES_VERSION=v1.1.3
POSTGRES_IMAGE=ghcr.io/cloudnative-pg/postgresql:17.11-standard-trixie
MAILPIT_VERSION=v1.32.0
RCLONE_VERSION=1.75.2
CADDY_VERSION=2.11.9

# --- Hetzner ---
HCLOUD_LOCATION=hel1
HCLOUD_SERVER_TYPE=cx23
# 3 nodes; 4 is the last step within the budget (review 2 C-1). check-plan.sh refuses more.
NODE_COUNT=3
HCLOUD_LB_TYPE=lb11

# --- Budget (review 2 C-2) ---
BUDGET_EUR_PER_MONTH=50
# renovate: datasource=helm registryUrl=https://charts.jetstack.io depName=cert-manager
# (the Barman Cloud plugin needs cert-manager for its mTLS with the operator)
CERT_MANAGER_CHART_VERSION=v1.20.5

# --- Backups (review 1 B-3) ---
# Object lock of the backup buckets, COMPLIANCE mode, in days. tofu/persistent gets it as
# retention_days (steps.sh); check-plan.sh refuses any other lock.
BACKUP_LOCK_DAYS=7
